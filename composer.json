{
    "name": "hananils/kirby-typographer",
    "description": "Typographer is a plugin that offers methods to apply advanced typographic rules to your content. Besides handling common cases like quotes, apostrophes or dashes out of the box, it allows for the creation of custom corrections and helps to typeset your content inside your templates and snippets smoothly.",
    "license": "MIT",
    "type": "kirby-plugin",
    "version": "4.0.1",
    "authors": [
        {
            "name": "hana+nils · Büro für Gestaltung",
            "email": "buero@hananils.de"
        }
    ],
    "homepage": "https://kirby.hananils.de/plugins/typographer",
    "require": {
        "php": "^8.5",
        "hananils/document": "dev-main",
        "hananils/kirby-plugins": "dev-main",
        "hananils/kirby-fields": "dev-main"
    },
    "require-dev": {
        "pestphp/pest": "^3.8"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/hananils/document.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/hananils/kirby-plugins.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/hananils/kirby-fields.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "Hananils\\Typographer\\": "lib"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}